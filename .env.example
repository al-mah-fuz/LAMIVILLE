# Supabase Configuration (Required for LAMIVILLE)
# Get these from your Supabase Project Settings -> API
# Both VITE_ and NEXT_PUBLIC_ prefixes are supported for Vite & Vercel deployment.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Alternative prefix supported when deploying to Next.js or Vercel:
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SECURITY WARNING:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser or frontend client!
# All client requests MUST use the public anon key with Row Level Security (RLS) policies.

# Optional app URL and Gemini Key
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

