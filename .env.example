# Supabase Configuration (Required for LAMIVILLE)
# Get these from your Supabase Project Settings -> API

# Client & Public API (Exposed to Vite/Browser)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Alternative prefix supported when deploying to Next.js or Vercel:
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SERVER-ONLY CREDENTIALS (NEVER prefix with VITE_ or expose to client!):
# Set this in your Vercel Project Settings -> Environment Variables.
# Used exclusively by the server API (/api/products, /api/upload-image) to execute
# verified admin operations with full service privileges, safely bypassing RLS code 42501.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional app URL and Gemini Key
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

